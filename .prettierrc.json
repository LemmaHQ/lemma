{
    "tabWidth": 4,
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "",
        "^(#|@/)",
        "",
        "^[.]"
    ],
    "importOrderTypeScriptVersion": "7.0.2",
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["web/src/**/*.tsx", "web/src/**/*.ts"],
            "options": {
                "plugins": [
                    "@ianvs/prettier-plugin-sort-imports",
                    "prettier-plugin-tailwindcss"
                ],
                "tailwindStylesheet": "./web/src/index.css",
                "tailwindFunctions": ["cn", "cva"]
            }
        }
    ]
}
