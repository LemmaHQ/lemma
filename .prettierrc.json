{
    "tabWidth": 4,
    "overrides": [
        {
            "files": ["*.yml", "*.yaml"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["web/src/**/*.tsx", "web/src/**/*.ts"],
            "options": {
                "plugins": ["prettier-plugin-tailwindcss"],
                "tailwindStylesheet": "./web/src/index.css",
                "tailwindFunctions": ["cn", "cva"]
            }
        }
    ]
}
