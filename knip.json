{
    "$schema": "https://unpkg.com/knip@6/schema.json",
    "ignoreExportsUsedInFile": {
        "interface": true,
        "type": true
    },
    "workspaces": {
        ".": {
            "entry": [
                "scripts/*/{verify,gen,translate}-*.ts",
                "scripts/**/*.test.ts"
            ],
            "ignoreBinaries": ["just"],
            "project": ["scripts/**/*.ts"],
            "ignoreDependencies": [
                "autocorrect-node",
                "jscpd",
                "markdownlint-cli2"
            ]
        },
        "web": {
            "ignoreBinaries": ["buf"],
            "ignoreDependencies": [
                "@bufbuild/protoc-gen-es",
                "@ianvs/prettier-plugin-sort-imports",
                "prettier-plugin-tailwindcss"
            ]
        },
        "desktop": {
            "ignoreDependencies": ["@ianvs/prettier-plugin-sort-imports"]
        },
        "packages/ui": {
            "project": ["src/**/*.{ts,tsx}"],
            "includeEntryExports": true,
            "ignoreDependencies": ["@ianvs/prettier-plugin-sort-imports"]
        }
    }
}
