CREATE TABLE IF NOT EXISTS messages (
    id TEXT NOT NULL PRIMARY KEY,
    conversationId TEXT NOT NULL,
    role TEXT NOT NULL,
    content TEXT NOT NULL,
    providerId TEXT NOT NULL,
    model TEXT NOT NULL,
    status INTEGER NOT NULL,
    createdAtMs INTEGER NOT NULL,
    seq INTEGER NOT NULL,
    syncSeq INTEGER NOT NULL
);

CREATE INDEX IF NOT EXISTS messages_conversation ON messages(conversationId, seq);

upsertMessage:
INSERT INTO messages VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)
ON CONFLICT(id) DO UPDATE SET
    conversationId = excluded.conversationId,
    role = excluded.role,
    content = excluded.content,
    providerId = excluded.providerId,
    model = excluded.model,
    status = excluded.status,
    createdAtMs = excluded.createdAtMs,
    seq = excluded.seq,
    syncSeq = excluded.syncSeq
WHERE excluded.syncSeq > messages.syncSeq;

listMessages:
SELECT * FROM messages WHERE conversationId = ? ORDER BY seq ASC;

deleteMessagesOf:
DELETE FROM messages WHERE conversationId = ?;
