{
    "name": "@lemma/ui",
    "version": "0.1.0",
    "private": true,
    "description": "Lemma UI components",
    "type": "module",
    "sideEffects": [
        "*.css"
    ],
    "imports": {
        "#primitives/*": "./src/components/primitives/*.tsx",
        "#ai/*": "./src/components/ai/*.tsx",
        "#icons/*": "./src/components/icons/*.tsx",
        "#hooks/*": "./src/hooks/*.ts",
        "#lib/*": "./src/lib/*.ts"
    },
    "exports": {
        ".": "./src/index.ts",
        "./styles.css": "./src/styles/index.css"
    },
    "scripts": {
        "type-check": "tsc",
        "prelint": "node ../../scripts/design-token/gen-tokens.ts",
        "lint": "oxlint",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "format": "prettier --write . --ignore-path ../../.gitignore",
        "format:check": "prettier --check . --ignore-path ../../.gitignore"
    },
    "peerDependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "@animate-ui/react": "^2.4.3",
        "@base-ui/react": "^1.9.0",
        "@streamdown/cjk": "^1.0.4",
        "@streamdown/code": "^2.0.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.2",
        "lucide-react": "^1.70.0",
        "motion": "^14.11.1",
        "shadcn": "^4.23.0",
        "shiki": "^4.6.0",
        "sonner": "^2.0.8",
        "streamdown": "^2.7.1",
        "tw-animate-css": "^1.4.0",
        "use-stick-to-bottom": "^1.1.6"
    },
    "devDependencies": {
        "@shadcn/lint": "^0.2.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitest/coverage-v8": "^5.0.5",
        "happy-dom": "^21.0.4",
        "oxlint-tailwindcss": "^1.17.1",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5"
    }
}
