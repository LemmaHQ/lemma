{
    "name": "@lemma/ui",
    "version": "0.1.0",
    "private": true,
    "description": "Lemma UI components",
    "type": "module",
    "imports": {
        "#components/*": "./src/components/*.tsx",
        "#hooks/*": "./src/hooks/*.ts",
        "#icons/*": "./src/components/animate-ui/icons/*.tsx"
    },
    "exports": {
        "./globals.css": "./src/styles/globals.css",
        "./motion.css": "./src/styles/motion.css",
        "./chat-composer.css": "./src/styles/chat-composer.css",
        "./thinking.css": "./src/styles/thinking.css",
        "./streamdown.css": "./src/styles/streamdown.css",
        "./tool-call.css": "./src/styles/tool-call.css",
        "./tokens.css": "./src/tokens/index.css",
        "./components/ai-elements/*": "./src/components/ai-elements/*.tsx",
        "./components/*": "./src/components/*.tsx",
        "./hooks/*": "./src/hooks/*.ts",
        "./lib/*": "./src/lib/*.ts",
        "./icons/*": "./src/components/animate-ui/icons/*.tsx",
        "./locales/*": "./src/i18n/locales/*"
    },
    "scripts": {
        "type-check": "tsc",
        "prelint": "node ../../design/gen-tokens.ts",
        "lint": "oxlint",
        "format": "prettier --write . --ignore-path ../../.gitignore",
        "format:check": "prettier --check . --ignore-path ../../.gitignore"
    },
    "peerDependencies": {
        "i18next": "^26.4.7",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.0.21",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "@animate-ui/react": "^2.3.0",
        "@base-ui/react": "^1.9.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "lucide-react": "^1.64.0",
        "motion": "^14.6.0",
        "shadcn": "^4.22.1",
        "shiki": "^4.5.0",
        "sonner": "^2.0.8",
        "streamdown": "^2.7.1",
        "tw-animate-css": "^1.4.0",
        "use-stick-to-bottom": "^1.1.6"
    },
    "devDependencies": {
        "@shadcn/lint": "^0.2.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "oxlint-tailwindcss": "^1.16.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}
