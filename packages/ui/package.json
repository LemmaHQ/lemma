{
    "name": "@lemma/ui",
    "version": "0.1.0",
    "private": true,
    "description": "Lemma UI components",
    "type": "module",
    "imports": {
        "#components/*": "./src/components/*.tsx",
        "#hooks/*": "./src/hooks/*.ts"
    },
    "exports": {
        "./globals.css": "./src/styles/globals.css",
        "./components/*": "./src/components/*.tsx",
        "./hooks/*": "./src/hooks/*.ts",
        "./locales/*": "./src/i18n/locales/*"
    },
    "scripts": {
        "type-check": "tsc",
        "prelint": "node ../../design/gen-tokens.ts",
        "lint": "oxlint",
        "format": "prettier --write . --ignore-path ../../.gitignore",
        "format:check": "prettier --check . --ignore-path ../../.gitignore"
    },
    "peerDependencies": {
        "i18next": "^26.4.7",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.0.21",
        "tailwindcss": "^4.3.3"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@tabler/icons-react": "^3.49.0",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.5.0",
        "shadcn": "^4.22.1",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@shadcn/lint": "^0.2.3",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "oxlint-tailwindcss": "^1.16.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2"
    }
}
