{
    "$schema": "../../node_modules/oxlint/configuration_schema.json",
    "extends": ["../../.oxlintrc.json"],
    "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "react",
        "jsx-a11y"
    ],
    "jsPlugins": ["oxlint-tailwindcss", "@shadcn/lint"],
    "env": {
        "builtin": true,
        "browser": true
    },
    "settings": {
        "tailwindcss": {
            "entryPoint": "src/styles/index.css"
        }
    },
    "rules": {
        "import/no-unassigned-import": [
            "error",
            { "allow": ["**/*.css", "./i18n"] }
        ],
        "react/react-in-jsx-scope": "off",
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/only-export-components": [
            "error",
            { "allowConstantExport": true }
        ],
        "tailwindcss/no-conflicting-classes": "error",
        "tailwindcss/no-contradicting-variants": "error",
        "tailwindcss/no-dark-without-light": "error",
        "tailwindcss/no-duplicate-classes": "error",
        "tailwindcss/enforce-canonical": "error",
        "tailwindcss/enforce-negative-arbitrary-values": "error",
        "tailwindcss/no-deprecated-classes": "error",
        "tailwindcss/no-unnecessary-arbitrary-value": "error",
        "tailwindcss/prefer-scale-token": "error",
        "tailwindcss/prefer-theme-tokens": "error",
        "tailwindcss/consistent-variant-order": "error",
        "tailwindcss/enforce-consistent-important-position": "error",
        "tailwindcss/enforce-consistent-variable-syntax": "error",
        "tailwindcss/enforce-shorthand": "error",
        "tailwindcss/no-unnecessary-whitespace": "error",
        "tailwindcss/no-restricted-classes": [
            "error",
            {
                "patterns": [
                    {
                        "pattern": "(^|:)dark:",
                        "message": "semantic tokens already switch with the theme"
                    },
                    {
                        "pattern": "(^|:)duration-\\d+$",
                        "message": "use a motion duration: duration-fast, duration-base, duration-medium, duration-slow, or duration-reveal"
                    },
                    {
                        "pattern": "(^|:)ease-(in|out|in-out|linear)$",
                        "message": "use a motion easing: ease-enter, ease-exit, ease-move, or ease-spring"
                    },
                    {
                        "pattern": "(^|:)text-(xs|sm|base|lg|xl|[2-9]xl)(/|$)",
                        "message": "use a type role: text-caption, text-small, text-body, text-reading, text-title, or text-display"
                    },
                    {
                        "pattern": "(^|:)rounded(-(t|r|b|l|s|e|tl|tr|br|bl|ss|se|es|ee))?-(xs|xl|2xl|3xl|4xl|\\[(?!inherit\\]).*\\])$",
                        "message": "use a corner radius: rounded-sm, rounded-md, rounded-lg, or rounded-full"
                    },
                    {
                        "pattern": "(^|:)shadow-(2xs|xs|sm|md|lg|xl|2xl)$",
                        "message": "use an elevation shadow: shadow-raised, shadow-overlay, or shadow-modal"
                    },
                    {
                        "pattern": "(^|:)[a-z-]+-(black|white)(/|$)",
                        "message": "use a semantic color role"
                    }
                ]
            }
        ],
        "shadcn/no-restyle": ["error", { "allow": ["layout"] }],
        "shadcn/no-raw-colors": "error",
        "shadcn/no-arbitrary-values": "error",
        "shadcn/no-inline-styles": "error",
        "shadcn/no-unknown-classes": "error",
        "shadcn/require-static-classes": "error"
    },
    "overrides": [
        {
            "files": ["src/components/**"],
            "rules": {
                "shadcn/no-restyle": "off",
                "shadcn/no-arbitrary-values": "off",
                "jsx-a11y/prefer-tag-over-role": "off",
                "shadcn/require-static-classes": "off"
            }
        }
    ]
}
