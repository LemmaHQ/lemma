{
    "name": "desktop",
    "productName": "Lemma",
    "version": "0.1.0",
    "description": "Lemma desktop client",
    "main": ".vite/build/main.js",
    "private": true,
    "scripts": {
        "build": "npm --workspace=web run build:desktop && tsc",
        "prestart": "npm run build",
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "lint": "oxlint",
        "test": "vitest run",
        "test:cov": "vitest run --coverage",
        "format": "prettier --write . --ignore-path ../.gitignore",
        "format:check": "prettier --check . --ignore-path ../.gitignore"
    },
    "author": {
        "name": "wanzhao-ysy",
        "email": "wanzhao_ysy@qq.com"
    },
    "devDependencies": {
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-deb": "^7.11.2",
        "@electron-forge/maker-rpm": "^8.0.1",
        "@electron-forge/maker-squirrel": "^7.11.2",
        "@electron-forge/maker-zip": "^8.0.1",
        "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
        "@electron-forge/plugin-fuses": "^8.0.1",
        "@electron-forge/plugin-vite": "^7.11.2",
        "@electron/fuses": "^2.1.3",
        "@types/electron-squirrel-startup": "^1.0.2",
        "@types/node": "^26.6.5",
        "@vitest/coverage-v8": "^5.0.5",
        "electron": "44.8.0",
        "prettier": "^3.9.10",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "dependencies": {
        "electron-squirrel-startup": "^1.0.1"
    }
}
