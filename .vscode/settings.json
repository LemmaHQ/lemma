{
    "i18n-ally.localesPaths": ["web/src/i18n/locales"],
    "i18n-ally.enabledFrameworks": ["react-i18next"],
    "i18n-ally.enabledParsers": ["json"],
    "i18n-ally.sourceLanguage": "en",
    "i18n-ally.displayLanguage": "zh",
    "i18n-ally.sortKeys": true,
    "eslint.validate": [
        "javascript",
        "javascriptreact",
        "typescript",
        "typescriptreact"
    ]
}
