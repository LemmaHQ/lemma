CREATE TABLE cached_message (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL,
    role INTEGER NOT NULL,
    content TEXT NOT NULL,
    created_at INTEGER NOT NULL
);

selectMessagesByConversation:
SELECT * FROM cached_message WHERE conversation_id = ? ORDER BY created_at ASC;

insertOrReplaceMessage:
INSERT OR REPLACE INTO cached_message(id, conversation_id, role, content, created_at)
VALUES (?, ?, ?, ?, ?);
