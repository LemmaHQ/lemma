CREATE TABLE cached_messages (
    session_id TEXT NOT NULL,
    position INTEGER NOT NULL,
    body TEXT NOT NULL,
    PRIMARY KEY (session_id, position)
);

selectMessageBodies:
SELECT body FROM cached_messages WHERE session_id = ? ORDER BY position ASC;

insertMessage:
INSERT INTO cached_messages(session_id, position, body) VALUES (?, ?, ?);

deleteSessionMessages:
DELETE FROM cached_messages WHERE session_id = ?;

deleteAllMessages:
DELETE FROM cached_messages;
