{
    "palette": {
        "$type": "color",
        "white": { "$value": "#ffffff" },
        "black": { "$value": "#000000" },
        "gray": {
            "100": { "$value": "#f5f5f5" },
            "800": { "$value": "#292929" },
            "850": { "$value": "#1f1f1f" },
            "900": { "$value": "#121212" }
        },
        "blue": {
            "400": { "$value": "#1a88ff" },
            "500": { "$value": "#1783ff" }
        },
        "red": {
            "400": { "$value": "#ff4756" },
            "600": { "$value": "#d92033" }
        },
        "black-alpha": {
            "3": { "$value": "#00000008" },
            "5": { "$value": "#0000000d" },
            "6": { "$value": "#0000000f" },
            "12": { "$value": "#0000001f" },
            "13": { "$value": "#00000021" },
            "15": { "$value": "#00000026" },
            "27": { "$value": "#00000045" },
            "45": { "$value": "#00000073" },
            "60": { "$value": "#00000099" },
            "90": { "$value": "#000000e6" }
        },
        "white-alpha": {
            "5": { "$value": "#ffffff0d" },
            "8": { "$value": "#ffffff14" },
            "10": { "$value": "#ffffff1a" },
            "12": { "$value": "#ffffff1f" },
            "18": { "$value": "#ffffff2e" },
            "28": { "$value": "#ffffff47" },
            "42": { "$value": "#ffffff6b" },
            "56": { "$value": "#ffffff8f" },
            "84": { "$value": "#ffffffd6" }
        },
        "gray-900-alpha": {
            "84": { "$value": "#121212d6" }
        },
        "blue-400-alpha": {
            "40": { "$value": "#1a88ff66" }
        },
        "blue-500-alpha": {
            "40": { "$value": "#1783ff66" }
        },
        "ink-alpha": {
            "5": { "$value": "#11161f0d" },
            "8": { "$value": "#11161f14" }
        }
    },
    "font": {
        "$type": "fontFamily",
        "sans": {
            "$value": [
                "Sarasa UI SC",
                "ui-sans-serif",
                "system-ui",
                "-apple-system",
                "Segoe UI",
                "Roboto",
                "Helvetica Neue",
                "Arial",
                "PingFang SC",
                "Hiragino Sans GB",
                "Microsoft YaHei",
                "sans-serif"
            ]
        },
        "mono": {
            "$value": [
                "Maple Mono NF CN",
                "ui-monospace",
                "SF Mono",
                "SFMono-Regular",
                "Menlo",
                "Consolas",
                "Liberation Mono",
                "monospace"
            ]
        }
    },
    "typography": {
        "$type": "typography",
        "display-xl": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "80px",
                "fontWeight": 500,
                "lineHeight": 1.05,
                "letterSpacing": "-3px"
            }
        },
        "display-lg": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "56px",
                "fontWeight": 500,
                "lineHeight": 1.1,
                "letterSpacing": "-1.8px"
            }
        },
        "display-md": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "40px",
                "fontWeight": 500,
                "lineHeight": 1.15,
                "letterSpacing": "-1px"
            }
        },
        "headline": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "28px",
                "fontWeight": 500,
                "lineHeight": 1.2,
                "letterSpacing": "-0.6px"
            }
        },
        "card-title": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "22px",
                "fontWeight": 500,
                "lineHeight": 1.25,
                "letterSpacing": "-0.4px"
            }
        },
        "subhead": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "20px",
                "fontWeight": 400,
                "lineHeight": 1.4,
                "letterSpacing": "-0.2px"
            }
        },
        "body-lg": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "18px",
                "fontWeight": 400,
                "lineHeight": 1.5,
                "letterSpacing": "-0.1px"
            }
        },
        "body": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "16px",
                "fontWeight": 400,
                "lineHeight": 1.5,
                "letterSpacing": "-0.05px"
            }
        },
        "body-sm": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "14px",
                "fontWeight": 400,
                "lineHeight": 1.6,
                "letterSpacing": "0px"
            }
        },
        "caption": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "12px",
                "fontWeight": 400,
                "lineHeight": 1.4,
                "letterSpacing": "0px"
            }
        },
        "button": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "14px",
                "fontWeight": 500,
                "lineHeight": 1.2,
                "letterSpacing": "0px"
            }
        },
        "eyebrow": {
            "$value": {
                "fontFamily": "{font.sans}",
                "fontSize": "13px",
                "fontWeight": 500,
                "lineHeight": 1.3,
                "letterSpacing": "0.4px"
            }
        },
        "mono": {
            "$value": {
                "fontFamily": "{font.mono}",
                "fontSize": "13px",
                "fontWeight": 400,
                "lineHeight": 1.5,
                "letterSpacing": "0px"
            }
        },
        "mono-sm": {
            "$value": {
                "fontFamily": "{font.mono}",
                "fontSize": "12px",
                "fontWeight": 400,
                "lineHeight": 1.4,
                "letterSpacing": "0px"
            }
        }
    },
    "radius": {
        "$type": "dimension",
        "xs": { "$value": "4px" },
        "sm": { "$value": "6px" },
        "md": { "$value": "8px" },
        "lg": { "$value": "12px" },
        "xl": { "$value": "16px" },
        "xxl": { "$value": "24px" },
        "pill": { "$value": "9999px" },
        "full": { "$value": "9999px" }
    },
    "duration": {
        "$type": "duration",
        "micro": { "$value": "60ms" },
        "fast": { "$value": "120ms" },
        "normal": { "$value": "200ms" },
        "slow": { "$value": "300ms" },
        "popover": { "$value": "140ms" },
        "dialog": { "$value": "180ms" },
        "dialog-exit": { "$value": "135ms" },
        "panel": { "$value": "240ms" },
        "list": { "$value": "180ms" }
    },
    "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.4, 0, 0.2, 1] },
        "out": { "$value": [0, 0, 0.2, 1] },
        "in": { "$value": [0.4, 0, 1, 1] },
        "motion-out": { "$value": [0.23, 1, 0.32, 1] },
        "panel": { "$value": [0.32, 0.72, 0, 1] }
    },
    "light": {
        "color": {
            "$type": "color",
            "primary": { "$value": "{palette.blue.500}" },
            "primary-foreground": { "$value": "{palette.white}" },
            "ring": { "$value": "{palette.blue-500-alpha.40}" },
            "background": { "$value": "{palette.white}" },
            "foreground": { "$value": "{palette.black-alpha.90}" },
            "glass": { "$value": "{palette.white-alpha.84}" },
            "card": { "$value": "{palette.white}" },
            "card-foreground": { "$value": "{palette.black-alpha.90}" },
            "popover": { "$value": "{palette.white}" },
            "popover-foreground": { "$value": "{palette.black-alpha.90}" },
            "secondary": { "$value": "{palette.black-alpha.5}" },
            "secondary-foreground": { "$value": "{palette.black-alpha.90}" },
            "muted": { "$value": "{palette.black-alpha.3}" },
            "muted-foreground": { "$value": "{palette.black-alpha.60}" },
            "accent": { "$value": "{palette.black-alpha.5}" },
            "accent-foreground": { "$value": "{palette.black-alpha.90}" },
            "destructive": { "$value": "{palette.red.600}" },
            "destructive-foreground": { "$value": "{palette.white}" },
            "border": { "$value": "{palette.black-alpha.13}" },
            "input": { "$value": "{palette.black-alpha.13}" },
            "sidebar": { "$value": "{palette.gray.100}" },
            "sidebar-foreground": { "$value": "{palette.black-alpha.90}" },
            "sidebar-border": { "$value": "{palette.black-alpha.13}" },
            "sidebar-accent": { "$value": "{palette.black-alpha.6}" },
            "sidebar-accent-foreground": {
                "$value": "{palette.black-alpha.90}"
            },
            "code": { "$value": "{palette.gray.100}" },
            "code-foreground": { "$value": "{palette.black-alpha.90}" },
            "code-border": { "$value": "{palette.black-alpha.13}" }
        },
        "shadow": {
            "$type": "shadow",
            "xs": {
                "$value": {
                    "color": "{palette.ink-alpha.5}",
                    "offsetX": "0px",
                    "offsetY": "1px",
                    "blur": "2px",
                    "spread": "0px"
                }
            },
            "md": {
                "$value": [
                    {
                        "color": "{palette.ink-alpha.8}",
                        "offsetX": "0px",
                        "offsetY": "4px",
                        "blur": "12px",
                        "spread": "-2px"
                    },
                    {
                        "color": "{palette.ink-alpha.5}",
                        "offsetX": "0px",
                        "offsetY": "2px",
                        "blur": "4px",
                        "spread": "-2px"
                    }
                ]
            },
            "composer": {
                "$value": {
                    "color": "{palette.black-alpha.12}",
                    "offsetX": "0px",
                    "offsetY": "8px",
                    "blur": "30px",
                    "spread": "0px"
                }
            }
        }
    },
    "dark": {
        "color": {
            "$type": "color",
            "primary": { "$value": "{palette.blue.400}" },
            "primary-foreground": { "$value": "{palette.white}" },
            "ring": { "$value": "{palette.blue-400-alpha.40}" },
            "background": { "$value": "{palette.gray.900}" },
            "foreground": { "$value": "{palette.white-alpha.84}" },
            "glass": { "$value": "{palette.gray-900-alpha.84}" },
            "card": { "$value": "{palette.gray.850}" },
            "card-foreground": { "$value": "{palette.white-alpha.84}" },
            "popover": { "$value": "{palette.gray.850}" },
            "popover-foreground": { "$value": "{palette.white-alpha.84}" },
            "secondary": { "$value": "{palette.white-alpha.10}" },
            "secondary-foreground": { "$value": "{palette.white-alpha.84}" },
            "muted": { "$value": "{palette.white-alpha.5}" },
            "muted-foreground": { "$value": "{palette.white-alpha.56}" },
            "accent": { "$value": "{palette.white-alpha.10}" },
            "accent-foreground": { "$value": "{palette.white-alpha.84}" },
            "destructive": { "$value": "{palette.red.400}" },
            "destructive-foreground": { "$value": "{palette.white}" },
            "border": { "$value": "{palette.white-alpha.12}" },
            "input": { "$value": "{palette.white-alpha.12}" },
            "sidebar": { "$value": "{palette.gray.850}" },
            "sidebar-foreground": { "$value": "{palette.white-alpha.84}" },
            "sidebar-border": { "$value": "{palette.white-alpha.12}" },
            "sidebar-accent": { "$value": "{palette.white-alpha.8}" },
            "sidebar-accent-foreground": {
                "$value": "{palette.white-alpha.84}"
            },
            "code": { "$value": "{palette.gray.850}" },
            "code-foreground": { "$value": "{palette.white-alpha.84}" },
            "code-border": { "$value": "{palette.white-alpha.12}" }
        },
        "shadow": {
            "$type": "shadow",
            "xs": {
                "$value": {
                    "color": "{palette.ink-alpha.5}",
                    "offsetX": "0px",
                    "offsetY": "1px",
                    "blur": "2px",
                    "spread": "0px"
                }
            },
            "md": {
                "$value": [
                    {
                        "color": "{palette.ink-alpha.8}",
                        "offsetX": "0px",
                        "offsetY": "4px",
                        "blur": "12px",
                        "spread": "-2px"
                    },
                    {
                        "color": "{palette.ink-alpha.5}",
                        "offsetX": "0px",
                        "offsetY": "2px",
                        "blur": "4px",
                        "spread": "-2px"
                    }
                ]
            },
            "composer": {
                "$value": {
                    "color": "{palette.black-alpha.60}",
                    "offsetX": "0px",
                    "offsetY": "12px",
                    "blur": "40px",
                    "spread": "0px"
                }
            }
        }
    }
}
