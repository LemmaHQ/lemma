{
    "palette": {
        "$type": "color",
        "white": { "$value": "#ffffff" },
        "gray": {
            "100": { "$value": "#f5f5f5" },
            "800": { "$value": "#292929" },
            "850": { "$value": "#1f1f1f" },
            "900": { "$value": "#121212" }
        },
        "neutral": {
            "50": { "$value": "#fafafa" },
            "100": { "$value": "#f5f5f5" },
            "200": { "$value": "#e5e5e5" },
            "300": { "$value": "#d4d4d4" },
            "400": { "$value": "#a3a3a3" },
            "500": { "$value": "#737373" },
            "600": { "$value": "#525252" },
            "700": { "$value": "#404040" },
            "800": { "$value": "#262626" },
            "900": { "$value": "#171717" },
            "950": { "$value": "#0a0a0a" }
        },
        "blue": {
            "400": { "$value": "#1a88ff" },
            "500": { "$value": "#1783ff" }
        },
        "red": {
            "400": { "$value": "#ff4756" },
            "600": { "$value": "#d92033" }
        },
        "black-alpha": {
            "3": { "$value": "#00000008" },
            "5": { "$value": "#0000000d" },
            "13": { "$value": "#00000021" },
            "15": { "$value": "#00000026" },
            "27": { "$value": "#00000045" },
            "45": { "$value": "#00000073" },
            "60": { "$value": "#00000099" },
            "90": { "$value": "#000000e6" }
        },
        "white-alpha": {
            "5": { "$value": "#ffffff0d" },
            "10": { "$value": "#ffffff1a" },
            "12": { "$value": "#ffffff1f" },
            "15": { "$value": "#ffffff26" },
            "18": { "$value": "#ffffff2e" },
            "28": { "$value": "#ffffff47" },
            "42": { "$value": "#ffffff6b" },
            "56": { "$value": "#ffffff8f" },
            "84": { "$value": "#ffffffd6" }
        }
    },
    "light": {
        "$type": "color",
        "background": { "$value": "{palette.white}" },
        "foreground": { "$value": "{palette.neutral.950}" },
        "card": { "$value": "{palette.white}" },
        "card-foreground": { "$value": "{palette.neutral.950}" },
        "popover": { "$value": "{palette.white}" },
        "popover-foreground": { "$value": "{palette.neutral.950}" },
        "primary": { "$value": "{palette.blue.500}" },
        "primary-foreground": { "$value": "{palette.white}" },
        "secondary": { "$value": "{palette.neutral.100}" },
        "secondary-foreground": { "$value": "{palette.neutral.900}" },
        "muted": { "$value": "{palette.neutral.100}" },
        "muted-foreground": { "$value": "{palette.neutral.500}" },
        "accent": { "$value": "{palette.neutral.100}" },
        "accent-foreground": { "$value": "{palette.neutral.900}" },
        "destructive": { "$value": "{palette.red.600}" },
        "border": { "$value": "{palette.neutral.200}" },
        "input": { "$value": "{palette.neutral.200}" },
        "ring": { "$value": "{palette.blue.500}" },
        "chart-1": { "$value": "{palette.neutral.300}" },
        "chart-2": { "$value": "{palette.neutral.500}" },
        "chart-3": { "$value": "{palette.neutral.600}" },
        "chart-4": { "$value": "{palette.neutral.700}" },
        "chart-5": { "$value": "{palette.neutral.800}" },
        "sidebar": { "$value": "{palette.neutral.50}" },
        "sidebar-foreground": { "$value": "{palette.neutral.950}" },
        "sidebar-primary": { "$value": "{palette.blue.500}" },
        "sidebar-primary-foreground": { "$value": "{palette.white}" },
        "sidebar-accent": { "$value": "{palette.neutral.100}" },
        "sidebar-accent-foreground": { "$value": "{palette.neutral.900}" },
        "sidebar-border": { "$value": "{palette.neutral.200}" },
        "sidebar-ring": { "$value": "{palette.blue.500}" }
    },
    "dark": {
        "$type": "color",
        "background": { "$value": "{palette.neutral.950}" },
        "foreground": { "$value": "{palette.neutral.50}" },
        "card": { "$value": "{palette.neutral.900}" },
        "card-foreground": { "$value": "{palette.neutral.50}" },
        "popover": { "$value": "{palette.neutral.900}" },
        "popover-foreground": { "$value": "{palette.neutral.50}" },
        "primary": { "$value": "{palette.blue.400}" },
        "primary-foreground": { "$value": "{palette.white}" },
        "secondary": { "$value": "{palette.neutral.800}" },
        "secondary-foreground": { "$value": "{palette.neutral.50}" },
        "muted": { "$value": "{palette.neutral.800}" },
        "muted-foreground": { "$value": "{palette.neutral.400}" },
        "accent": { "$value": "{palette.neutral.800}" },
        "accent-foreground": { "$value": "{palette.neutral.50}" },
        "destructive": { "$value": "{palette.red.400}" },
        "border": { "$value": "{palette.white-alpha.10}" },
        "input": { "$value": "{palette.white-alpha.15}" },
        "ring": { "$value": "{palette.blue.400}" },
        "chart-1": { "$value": "{palette.neutral.300}" },
        "chart-2": { "$value": "{palette.neutral.500}" },
        "chart-3": { "$value": "{palette.neutral.600}" },
        "chart-4": { "$value": "{palette.neutral.700}" },
        "chart-5": { "$value": "{palette.neutral.800}" },
        "sidebar": { "$value": "{palette.neutral.900}" },
        "sidebar-foreground": { "$value": "{palette.neutral.50}" },
        "sidebar-primary": { "$value": "{palette.blue.400}" },
        "sidebar-primary-foreground": { "$value": "{palette.white}" },
        "sidebar-accent": { "$value": "{palette.neutral.800}" },
        "sidebar-accent-foreground": { "$value": "{palette.neutral.50}" },
        "sidebar-border": { "$value": "{palette.white-alpha.10}" },
        "sidebar-ring": { "$value": "{palette.blue.400}" }
    },
    "motion": {
        "duration": {
            "$type": "duration",
            "fast": { "$value": { "value": 100, "unit": "ms" } },
            "base": { "$value": { "value": 150, "unit": "ms" } },
            "medium": { "$value": { "value": 200, "unit": "ms" } },
            "slow": { "$value": { "value": 300, "unit": "ms" } }
        },
        "easing": {
            "$type": "cubicBezier",
            "enter": { "$value": [0.22, 1, 0.36, 1] },
            "exit": { "$value": [0.4, 0, 1, 1] },
            "move": { "$value": [0.4, 0, 0.2, 1] }
        }
    }
}
