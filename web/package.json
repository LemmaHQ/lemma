        "oxlint-tailwindcss": "^1.16.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    }
