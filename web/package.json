{
    "name": "@lemma/web",
    "version": "0.1.0",
    "private": true,
    "description": "Lemma web client",
    "type": "module",
    "scripts": {
        "gen": "npm run gen:tokens && npm run gen:proto",
        "gen:tokens": "node ../design/gen-tokens.ts",
        "gen:proto": "cd ../proto && buf generate",
        "predev": "npm run gen",
        "dev": "vite",
        "prebuild": "npm run gen",
        "build": "tsc -b && vite build",
        "prebuild:desktop": "npm run gen",
        "build:desktop": "tsc -b && vite build --outDir ../desktop/web-dist --emptyOutDir",
        "prelint": "npm run gen",
        "lint": "oxlint",
        "preview": "vite preview",
        "pretest": "npm run gen",
        "test": "vitest run",
        "pretest:cov": "npm run gen",
        "test:cov": "vitest run --coverage",
        "preformat": "npm run gen:tokens",
        "format": "prettier --write . --ignore-path ../.gitignore",
        "preformat:check": "npm run gen:tokens",
        "format:check": "prettier --check . --ignore-path ../.gitignore"
    },
    "author": {
        "name": "wanzhao-ysy",
        "email": "wanzhao_ysy@qq.com"
    },
    "dependencies": {
        "@base-ui/react": "^1.9.0",
        "@bufbuild/protobuf": "^2.16.0",
        "@connectrpc/connect": "^2.2.0",
        "@connectrpc/connect-web": "^2.2.0",
        "@streamdown/cjk": "^1.0.4",
        "@streamdown/code": "^2.0.0",
        "@tabler/icons-react": "^3.49.0",
        "class-variance-authority": "^0.7.1",
        "cmdk": "^1.1.1",
        "cn": "^0.5.0",
        "i18next": "^26.5.11",
        "i18next-browser-languagedetector": "^8.2.3",
        "motion": "^14.6.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.9",
        "react-router": "^8.5.0",
        "shadcn": "^4.22.2",
        "shiki": "^4.5.0",
        "sonner": "^2.0.8",
        "streamdown": "^2.7.1",
        "tw-animate-css": "^1.4.0",
        "use-stick-to-bottom": "^1.1.6",
        "zustand": "^5.0.16"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.16.0",
        "@codecov/vite-plugin": "^2.0.1",
        "@lemma/desktop-bridge": "^0.1.0",
        "@shadcn/lint": "^0.2.3",
        "@tailwindcss/vite": "^4.3.3",
        "@types/node": "^26.6.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "@vitest/coverage-v8": "^5.0.5",
        "oxlint-tailwindcss": "^1.16.0",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
}
