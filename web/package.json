{
    "name": "@lemma/web",
    "version": "0.1.0",
    "private": true,
    "description": "Lemma web client",
    "type": "module",
    "sideEffects": [
        "*.css",
        "./src/main.tsx",
        "./src/i18n/index.ts"
    ],
    "scripts": {
        "gen": "npm run gen:tokens && npm run gen:i18n && npm run gen:proto",
        "gen:tokens": "node ../scripts/design-token/gen-tokens.ts",
        "gen:i18n": "node ../scripts/i18n/gen-i18n.ts",
        "gen:proto": "cd ../proto && buf generate",
        "predev": "npm run gen",
        "dev": "vite",
        "prebuild": "npm run gen",
        "build": "tsc -b && vite build",
        "prebuild:desktop": "npm run gen",
        "build:desktop": "tsc -b && vite build --outDir ../desktop/web-dist --emptyOutDir",
        "prelint": "npm run gen",
        "lint": "oxlint",
        "preview": "vite preview",
        "pretest": "npm run gen",
        "test": "vitest run",
        "pretest:cov": "npm run gen",
        "test:cov": "vitest run --coverage",
        "preformat": "npm run gen:tokens",
        "format": "prettier --write . --ignore-path ../.gitignore",
        "preformat:check": "npm run gen:tokens",
        "format:check": "prettier --check . --ignore-path ../.gitignore"
    },
    "author": {
        "name": "wanzhao-ysy",
        "email": "wanzhao_ysy@qq.com"
    },
    "dependencies": {
        "@bufbuild/protobuf": "^2.17.0",
        "@connectrpc/connect": "^2.3.0",
        "@connectrpc/connect-web": "^2.3.0",
        "@lemma/ui": "^0.1.0",
        "i18next": "^26.7.2",
        "i18next-browser-languagedetector": "^8.3.0",
        "next-themes": "^0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.1.13",
        "react-router": "^8.5.1",
        "zustand": "^5.1.0"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.17.0",
        "@codecov/vite-plugin": "^2.0.1",
        "@lemma/desktop-contract": "^0.1.0",
        "@shadcn/lint": "^0.2.5",
        "@tailwindcss/vite": "^4.3.5",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.9",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "@vitest/coverage-v8": "^5.0.5",
        "happy-dom": "^21.0.4",
        "oxlint-tailwindcss": "^1.17.1",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.8",
        "vitest": "^5.0.5"
    }
}
