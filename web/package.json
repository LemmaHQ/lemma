{
    "name": "web",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "gen:proto": "cd ../proto && buf generate",
        "predev": "npm run gen:proto",
        "dev": "vite",
        "prebuild": "npm run gen:proto",
        "build": "tsc -b && vite build",
        "prebuild:desktop": "npm run gen:proto",
        "build:desktop": "tsc -b && vite build --base=./ --outDir ../desktop/web-dist --emptyOutDir",
        "prelint": "npm run gen:proto",
        "lint": "oxlint",
        "preview": "vite preview",
        "pretest": "npm run gen:proto",
        "test": "vitest run",
        "pretest:cov": "npm run gen:proto",
        "test:cov": "vitest run --coverage",
        "format": "prettier --write . --ignore-path ../.gitignore",
        "format:check": "prettier --check . --ignore-path ../.gitignore"
    },
    "author": {
        "name": "wanzhao-ysy",
        "email": "wanzhao_ysy@qq.com"
    },
    "dependencies": {
        "@base-ui/react": "1.9.0",
        "@bufbuild/protobuf": "^2.16.0",
        "@connectrpc/connect": "^2.2.0",
        "@connectrpc/connect-web": "^2.2.0",
        "@radix-ui/react-use-controllable-state": "1.3.0",
        "@streamdown/cjk": "1.0.4",
        "@streamdown/code": "2.0.0",
        "@tabler/icons-react": "3.49.0",
        "ai": "7.0.143",
        "class-variance-authority": "^0.7.1",
        "cmdk": "1.1.1",
        "cn": "^0.5.0",
        "dexie": "^4.4.6",
        "i18next": "^26.4.7",
        "i18next-browser-languagedetector": "^8.2.1",
        "motion": "14.4.0",
        "nanoid": "3.3.20",
        "next-themes": "0.4.6",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-i18next": "^17.0.21",
        "react-router": "^8.4.0",
        "shadcn": "4.22.1",
        "shiki": "4.5.0",
        "sonner": "^2.0.8",
        "streamdown": "2.7.1",
        "tw-animate-css": "^1.4.0",
        "zustand": "^5.0.15"
    },
    "devDependencies": {
        "@bufbuild/protoc-gen-es": "^2.16.0",
