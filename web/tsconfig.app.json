{
    "extends": "../tsconfig.base.json",
    "compilerOptions": {
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "lib": ["ES2024", "DOM"],
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["vite/client"],
        "resolveJsonModule": true,
        "allowArbitraryExtensions": true,
        "allowImportingTsExtensions": true,
        "jsx": "react-jsx",
        "paths": {
            "@/*": ["./src/*"]
        }
    },
    "include": ["src"]
}
