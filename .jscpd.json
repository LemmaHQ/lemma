{
    "path": [
        "crates",
        "web/src",
        "desktop/src",
        "packages",
        "mobile",
        "scripts"
    ],
    "ignore": [
        "**/*.json",
        "**/*.yaml",
        "**/*.toml",
        "**/*.xml",
        "**/*.md",
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/src/*Test/**",
        "**/tests/**",
        "packages/ui/src/components/icons/**"
    ],
    "ignorePattern": ["(?m)^import\\s.*$", "(?m)^use\\s[^;]*;"],
    "minTokens": 70,
    "minLines": 8,
    "deadCode": {
        "entry": [
            "**/{verify,gen,translate}-*.ts",
            "**/engine-host.ts",
            "**/preload.ts"
        ]
    }
}
